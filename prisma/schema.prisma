datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String   @db.LongText
  summary     String   @db.Text
  coverImage  String?
  category    String
  status      String   @default("DRAFT") // DRAFT, PUBLISHED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String   @db.LongText
  eventDate   DateTime?
  location    String?
  coverImage  String?
  status      String   @default("DRAFT") // DRAFT, PUBLISHED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([eventDate])
  @@index([createdAt])
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String
  imageUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

model DoctorSchedule {
  id           Int      @id @default(autoincrement())
  poli         String
  doctorName   String
  scheduleInfo String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([poli])
  @@index([isActive])
}

model Facility {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  imageUrl    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model Partner {
  id          Int      @id @default(autoincrement())
  name        String
  logoUrl     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Service {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String   @unique
  description      String   @db.Text
  iconName         String
  isActive         Boolean  @default(true)
  roomImage        String?  @db.Text
  bannerImage      String?  @db.Text
  gallery          String?  @db.Text
  priceList        String?  @db.Text
  purpose          String?  @db.Text
  benefits         String?  @db.Text
  facilities       String?  @db.Text
  operationalHours String?  @db.Text
  preparation      String?  @db.Text
  procedures       String?  @db.Text
  faq              String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    String
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SurveyResponse {
  id          Int      @id @default(autoincrement())
  respondentName String
  contactNumber  String
  gender         String   // L, P
  age            Int
  education      String   // SD, SMP, SMA, D3, S1, S2
  occupation     String   // PNS, TNI, POLRI, SWASTA, WIRAUSAHA, LAINNYA
  occupationOther String?
  serviceReceived String
  q1             Int      // 1-4: Kesesuaian persyaratan
  q2             Int      // 1-4: Kemudahan prosedur
  q3             Int      // 1-4: Kecepatan pelayanan
  q4             Int      // 1-4: Kewajaran biaya
  q5             Int      // 1-4: Kesesuaian produk/standar
  q6             Int      // 1-4: Kompetensi petugas
  q7             Int      // 1-4: Kesopanan & keramahan
  q8             Int      // 1-4: Kualitas sarana prasarana
  q9             Int      // 1-4: Penanganan pengaduan
  feedback       String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([serviceReceived])
  @@index([createdAt])
}
