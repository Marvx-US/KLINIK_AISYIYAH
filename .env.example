# =============================================================
# KLINIK AISYIYAH — Environment Variables Template
# Salin file ini: cp .env.example .env
# Isi setiap nilai sesuai environment kamu (development / production)
# JANGAN pernah commit file .env ke Git!
# =============================================================

# ─── DATABASE ───────────────────────────────────────────────
# Format MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Contoh local:     mysql://root:@localhost:3306/klinik_aisyiyah
# Contoh production: mysql://klinik_user:StrongPass@127.0.0.1:3306/klinik_db
DATABASE_URL="mysql://root:@localhost:3306/klinik_aisyiyah"

# ─── AUTENTIKASI (JWT) ───────────────────────────────────────
# Secret untuk menandatangani JWT session. WAJIB diisi sebelum deploy.
# Generate nilai yang kuat di terminal:
#   openssl rand -hex 64
# MINIMAL 32 karakter. Gunakan 64 karakter untuk production.
NEXTAUTH_SECRET="ganti-dengan-secret-minimal-32-karakter-yang-sangat-acak"

# ─── URL APLIKASI ────────────────────────────────────────────
# URL publik aplikasi (tanpa trailing slash).
# Development: http://localhost:3000
# Production:  https://klinikaisyiyah.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── SEED DATABASE (Opsional) ────────────────────────────────
# Digunakan oleh prisma/seed.js untuk membuat akun admin pertama kali.
# Jika tidak diisi, seed akan gagal dengan error (default fallback dihapus).
# Wajib diisi di production sebelum menjalankan: npx prisma db seed
# Gunakan password kuat: minimal 16 karakter, kombinasi huruf/angka/simbol.
DEFAULT_ADMIN_USERNAME="admin@klinikaisyiyah.com"
DEFAULT_ADMIN_PASSWORD="GantiDenganPasswordKuatMinimal16Karakter!"
